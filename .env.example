# Copy this file to .env.local (npm run dev) or pass these as environment
# variables to the Docker container (see docker-compose.yml). Both values
# come from your Supabase project settings -> API. See README.md "Backend
# setup" for the full walkthrough (creating the project, running the SQL
# migration, enabling anonymous sign-ins, and configuring Google OAuth).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used by app/auth/callback/route.ts to build the redirect target after an
# OAuth login. Set this to the URL people actually load the app from.
# Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
